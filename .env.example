# ================================================================
# 1. APPLICATION & DATA PATHS
# ================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO

# Local Storage Paths (resolved relative to repository root)
DB_PATH=data/telecom.db
RAW_DATA_PATH=data/raw/WA_Fn-UseC_-Telco-Customer-Churn.csv
DOCS_DIR=data/docs
MODEL_BUNDLE_PATH=artifacts/telco_churn_model_bundle.joblib

# ================================================================
# 2. AZURE AI FOUNDRY (LLM & Embeddings)
# ================================================================
# Base resource endpoint (clean URL, no /openai/v1/responses suffix)
AZURE_OPENAI_ENDPOINT=https://<your-search-service-name>.services.ai.azure.com
AZURE_OPENAI_API_KEY=your_azure_foundry_api_key_here
AZURE_OPENAI_API_VERSION=2024-02-01

# Deployment names as registered under Azure AI Foundry -> Deployments
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ================================================================
# 3. AZURE AI SEARCH (Vector Store for Policy RAG)
# ================================================================
# Found in: Azure Portal -> Azure AI Search -> Overview (Url) and Keys (Admin Key)
AZURE_SEARCH_ENDPOINT=https://<your-search-service-name>.search.windows.net
AZURE_SEARCH_KEY=your_azure_search_admin_key_here
AZURE_SEARCH_INDEX_NAME=telecom-retention-index

# ================================================================
# 4. BUSINESS LOGIC & COST-OPTIMAL THRESHOLDS
# ================================================================
# t* cutoff derived from notebook cost-matrix optimization
CHURN_OPTIMAL_THRESHOLD=0.17
DEFAULT_THRESHOLD=0.50
